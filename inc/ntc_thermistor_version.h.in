/**
 * @file ntc_thermistor_version.h
 * @brief NTC_THERMISTOR driver version, generated by CMake from ntc_thermistor_version.h.in.
 * @copyright Copyright (c) 2026 The driver-ntc-thermistor authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/ntc_thermistor_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef NTC_THERMISTOR_VERSION_H
#define NTC_THERMISTOR_VERSION_H

/** Major version: incompatible API changes. */
#define NTC_THERMISTOR_VERSION_MAJOR @NTC_THERMISTOR_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define NTC_THERMISTOR_VERSION_MINOR @NTC_THERMISTOR_VERSION_MINOR@
/** Patch version: fixes. */
#define NTC_THERMISTOR_VERSION_PATCH @NTC_THERMISTOR_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define NTC_THERMISTOR_VERSION_STRING "@NTC_THERMISTOR_VERSION@"

#endif // NTC_THERMISTOR_VERSION_H
